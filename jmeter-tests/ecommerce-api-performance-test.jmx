
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="E-Commerce API Performance Test Strategy" enabled="true">
      <stringProp name="TestPlan.comments">Generated by Test Strategy Planner Agent - Version 1.0.0
      <boolProp name="TestPlan.functional_mode">false
      <boolProp name="TestPlan.tearDown_on_shutdown">true
      <boolProp name="TestPlan.serialize_threadgroups">true
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="protocol" elementType="Argument">
            <stringProp name="Argument.name">protocol
            <stringProp name="Argument.value">https
            <stringProp name="Argument.metadata">=
          
          <elementProp name="domain" elementType="Argument">
            <stringProp name="Argument.name">domain
            <stringProp name="Argument.value">api.store.example.com
            <stringProp name="Argument.metadata">=
          
          <elementProp name="port" elementType="Argument">
            <stringProp name="Argument.name">port
            <stringProp name="Argument.value">443
            <stringProp name="Argument.metadata">=
          
          <elementProp name="base_path" elementType="Argument">
            <stringProp name="Argument.name">base_path
            <stringProp name="Argument.value">/v1
            <stringProp name="Argument.metadata">=
          
        
      
      <stringProp name="TestPlan.user_define_classpath">
    
    
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults" enabled="true">
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
          <collectionProp name="Arguments.arguments"/>
        
        <stringProp name="HTTPSampler.domain">${domain}
        <stringProp name="HTTPSampler.port">${port}
        <stringProp name="HTTPSampler.protocol">${protocol}
        <stringProp name="HTTPSampler.contentEncoding">UTF-8
        <stringProp name="HTTPSampler.path">
        <stringProp name="HTTPSampler.concurrentPool">6
        <stringProp name="HTTPSampler.connect_timeout">10000
        <stringProp name="HTTPSampler.response_timeout">30000
      
      
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Content-Type
            <stringProp name="Header.value">application/json
          
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Accept
            <stringProp name="Header.value">application/json
          
        
      
      
      <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV Data Set - UserCredentials" enabled="true">
        <stringProp name="delimiter">,
        <stringProp name="fileEncoding">UTF-8
        <stringProp name="filename">test-data/user_credentials.csv
        <boolProp name="ignoreFirstLine">false
        <boolProp name="quotedData">false
        <boolProp name="recycle">true
        <stringProp name="shareMode">shareMode.all
        <boolProp name="stopThread">false
        <stringProp name="variableNames">username,password
      
      
      <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV Data Set - SearchParameters" enabled="true">
        <stringProp name="delimiter">,
        <stringProp name="fileEncoding">UTF-8
        <stringProp name="filename">test-data/search_params.csv
        <boolProp name="ignoreFirstLine">false
        <boolProp name="quotedData">false
        <boolProp name="recycle">true
        <stringProp name="shareMode">shareMode.all
        <boolProp name="stopThread">false
        <stringProp name="variableNames">category,page
      
      
      <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV Data Set - OrderData" enabled="true">
        <stringProp name="delimiter">,
        <stringProp name="fileEncoding">UTF-8
        <stringProp name="filename">test-data/order_data.csv
        <boolProp name="ignoreFirstLine">false
        <boolProp name="quotedData">false
        <boolProp name="recycle">true
        <stringProp name="shareMode">shareMode.all
        <boolProp name="stopThread">false
        <stringProp name="variableNames">cartId,paymentMethod
      
      
      <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV Data Set - AuthTokens" enabled="true">
        <stringProp name="delimiter">,
        <stringProp name="fileEncoding">UTF-8
        <stringProp name="filename">test-data/auth_tokens.csv
        <boolProp name="ignoreFirstLine">false
        <boolProp name="quotedData">false
        <boolProp name="recycle">true
        <stringProp name="shareMode">shareMode.all
        <boolProp name="stopThread">false
        <stringProp name="variableNames">token,userId
      
      
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="TG01_Critical_Authentication_Flow" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false
          <intProp name="LoopController.loops">-1
        
        <stringProp name="ThreadGroup.num_threads">50
        <stringProp name="ThreadGroup.ramp_time">60
        <boolProp name="ThreadGroup.scheduler">true
        <stringProp name="ThreadGroup.duration">300
        <stringProp name="ThreadGroup.delay">0
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true
      
      
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="[CRITICAL] POST /auth/login - User Login and Token Issuance" enabled="true">
          <boolProp name="HTTPSampler.postBodyRaw">true
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false
                <stringProp name="Argument.value">{"username":"${username}","password":"${password}"}
                <stringProp name="Argument.metadata">=
              
            
          
          <stringProp name="HTTPSampler.domain">
          <stringProp name="HTTPSampler.port">
          <stringProp name="HTTPSampler.protocol">
          <stringProp name="HTTPSampler.contentEncoding">
          <stringProp name="HTTPSampler.path">${base_path}/auth/login
          <stringProp name="HTTPSampler.method">POST
          <boolProp name="HTTPSampler.follow_redirects">true
          <boolProp name="HTTPSampler.auto_redirects">false
          <boolProp name="HTTPSampler.use_keepalive">true
          <boolProp name="HTTPSampler.DO_MULTIPART_POST">false
          <stringProp name="HTTPSampler.embedded_url_re">
          <stringProp name="HTTPSampler.connect_timeout">
          <stringProp name="HTTPSampler.response_timeout">
        
        
          <UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Uniform Random Timer" enabled="true">
            <stringProp name="ConstantTimer.delay">500
            <stringProp name="RandomTimer.range">300
          
          
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Response Code Assertion - 200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200
            
            <stringProp name="Assertion.custom_message">Verify successful authentication response
            <stringProp name="Assertion.test_field">Assertion.response_code
            <boolProp name="Assertion.assume_success">false
            <intProp name="Assertion.test_type">8
          
          
          <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duration Assertion - 1000ms" enabled="true">
            <stringProp name="DurationAssertion.duration">1000
          
          
          <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="JSON Path Assertion - token exists" enabled="true">
            <stringProp name="JSON_PATH">$.token
            <stringProp name="EXPECTED_VALUE">
            <boolProp name="JSONVALIDATION">false
            <boolProp name="EXPECT_NULL">false
            <boolProp name="INVERT">false
            <boolProp name="ISREGEX">false
          
          
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="JSON Extractor - auth_token" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">auth_token
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.token
            <stringProp name="JSONPostProcessor.match_numbers">1
            <stringProp name="JSONPostProcessor.defaultValues">TOKEN_NOT_FOUND
          
          
        
      
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="TG02_Critical_Catalog_Search_Flow" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
